TAVILY_API_KEY=
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=

# Optional, not used yet — reserved for future cross-verification of claims
PERPLEXITY_API_KEY=

# Optional override, defaults to claude-sonnet-5
# ANTHROPIC_MODEL=

# Optional override, defaults to Liam (Energetic, Social Media Creator)
# ELEVENLABS_VOICE_ID=

# Optional override, defaults to eleven_multilingual_v2
# ELEVENLABS_MODEL_ID=

# Optional override — path to a .ttf/.ttc font for video captions.
# Auto-detected from common macOS system fonts if unset.
# FONT_PATH=

# Required for `radar review serve` (the browser review page). Set a real
# password before sharing this with anyone — the default is a placeholder.
REVIEW_PASSWORD=changeme

# Signs the browser session cookie for `radar review serve`. Set this to a
# long random string in any real use — the default is fine for local-only,
# single-machine use but should not be reused anywhere sensitive.
REVIEW_SESSION_SECRET=dev-only-insecure-secret-change-in-env

# Optional override, defaults to 8000
# REVIEW_WEB_PORT=
